{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "cybercog/laravel-ban": "^4.11",
        "filament/filament": "^5.11",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "propaganistas/laravel-phone": "^6.1",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.5",
        "spatie/laravel-settings": "^3.10",
        "spatie/laravel-sluggable": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.8",
        "brianium/paratest": "<7.28",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.1",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "rector --memory-limit=2G",
            "pint --parallel"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run --memory-limit=2G"
        ],
        "test:types": "phpstan analyse --memory-limit=2G",
        "test:type-coverage": "pest --type-coverage --min=97",
        "test:unit": "pest --parallel",
        "test": [
            "@php artisan config:clear --ansi",
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
