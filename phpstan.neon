includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    # Read the literal arrays in our casts() methods so date, enum and array casts are typed.
    parseModelCastsMethod: true
    level: 7
    paths:
        - app
        - bootstrap/app.php
        - database
        - routes
        - config
        - public
    excludePaths:
        - database/migrations/*
    tmpDir: storage/framework/phpstan

